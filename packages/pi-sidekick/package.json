{
  "name": "@whamp/pi-sidekick",
  "version": "0.0.0",
  "description": "An opt-in persistent lead-and-sidekick workflow for Pi.",
  "type": "module",
  "license": "MIT",
  "author": "Will Hampson <whamp@ggl.slmail.me> (https://github.com/Whamp)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whamp/pi-extensions.git",
    "directory": "packages/pi-sidekick"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "sidekick",
    "agents"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "files": [
    "index.ts",
    "agents",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "examples/sidekick.json",
    "examples/smoke-project/math.mjs",
    "skills/sidekick-browser/SKILL.md",
    "tools/sidekick-browser/axi.mjs",
    "tools/sidekick-browser/package.json",
    "tools/sidekick-browser/package-lock.json"
  ],
  "scripts": {
    "test": "node --experimental-transform-types --test src/*.test.ts src/**/*.test.ts test/*.test.ts scripts/*.test.mjs tools/sidekick-browser/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "lint": "oxlint --type-aware --deny-warnings --ignore-pattern '**/*.test.ts' index.ts scripts src test/*.ts",
    "format": "oxfmt index.ts scripts src test",
    "format:check": "oxfmt --check index.ts scripts src test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-subagents": ">=0.67.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "pi-subagents": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.19.0",
    "c8": "10.1.3",
    "jiti": "2.7.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "pi-subagents": "0.67.0",
    "typebox": "1.3.27",
    "typescript": "^5.8.3"
  }
}
