{
	"name": "@whamp/pi-pstack",
	"version": "0.7.0",
	"description": "pstack for Pi: rigorous agent workflows you can parallelize with confidence - poteto-mode playbooks, engineering principles, multi-model review panels, and subagents.",
	"type": "module",
	"license": "MIT",
	"author": "Will Hampson <whamp@ggl.slmail.me> (https://github.com/Whamp)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Whamp/pi-extensions.git",
		"directory": "packages/pi-pstack"
	},
	"bugs": {
		"url": "https://github.com/Whamp/pi-extensions/issues"
	},
	"homepage": "https://github.com/Whamp/pi-extensions/tree/master/packages/pi-pstack#readme",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"skills",
		"workflow",
		"principles",
		"poteto-mode",
		"subagents",
		"unslop"
	],
	"files": [
		"extensions/",
		"!extensions/**/*.test.ts",
		"skills/",
		"agents/",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"typebox": "1.3.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/pstack/index.ts"
		],
		"skills": [
			"./skills"
		],
		"subagents": {
			"agents": [
				"./agents"
			]
		}
	},
	"scripts": {
		"test": "node --experimental-strip-types --test extensions/pstack/*.test.ts skills/poteto-mode/scripts/check-plan.test.mjs scripts/reground-from-cursor.test.mjs"
	}
}
