{
	"name": "@whamp/pi-subscription-quota",
	"version": "0.0.0",
	"description": "Concise Pi subscription quota observations through CodexBar",
	"keywords": [
		"pi-extension",
		"pi-package",
		"quota"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Whamp/pi-extensions.git",
		"directory": "packages/pi-subscription-quota"
	},
	"files": [
		"extensions/",
		"src/",
		"!src/**/*.test.ts",
		"!src/test-utils/",
		"scripts/",
		"!scripts/**/*.test.mjs",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"test": "node --experimental-strip-types --test src/*.test.ts scripts/*.test.mjs",
		"typecheck": "tsc --noEmit",
		"verify:live": "node --experimental-strip-types scripts/verify-live.mjs",
		"prepack": "cp --remove-destination ../../LICENSE LICENSE",
		"postpack": "ln -sfn ../../LICENSE LICENSE"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@types/node": "^22.10.2",
		"typebox": "^1.3.7",
		"typescript": "^5.7.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/subscription-quota/index.ts"
		]
	}
}
