{
  "name": "@zenspc/pi-todos",
  "version": "0.0.0",
  "description": "File-based todo management for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whamp/pi-extensions.git",
    "directory": "packages/pi-todos"
  },
  "bugs": {
    "url": "https://github.com/Whamp/pi-extensions/issues"
  },
  "homepage": "https://github.com/Whamp/pi-extensions/tree/master/packages/pi-todos#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "todos",
    "tui"
  ],
  "files": [
    "extensions/",
    "!extensions/**/*.test.ts",
    "!extensions/**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/todos/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test extensions/todos/*.test.ts",
    "prepack": "cp --remove-destination ../../LICENSE LICENSE",
    "postpack": "ln -sfn ../../LICENSE LICENSE"
  }
}
