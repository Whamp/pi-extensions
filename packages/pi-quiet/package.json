{
	"name": "@whamp/pi-quiet",
	"version": "0.4.2",
	"description": "Quiet Display for Pi: verb-first tool rows (built-in + Foreign), Verb Groups, sticky on/off.",
	"type": "module",
	"license": "MIT",
	"author": "Will Hampson <whamp@ggl.slmail.me> (https://github.com/Whamp)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Whamp/pi-extensions.git",
		"directory": "packages/pi-quiet"
	},
	"bugs": {
		"url": "https://github.com/Whamp/pi-extensions/issues"
	},
	"homepage": "https://github.com/Whamp/pi-extensions/tree/master/packages/pi-quiet#readme",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"quiet",
		"display",
		"ux",
		"tui"
	],
	"files": [
		"extensions/",
		"src/",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/quiet/index.ts"
		]
	},
	"scripts": {
		"test": "node --experimental-strip-types --test src/*.test.ts",
		"prepack": "cp --remove-destination ../../LICENSE LICENSE",
		"postpack": "ln -sfn ../../LICENSE LICENSE"
	}
}
