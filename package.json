{
  "name": "pi-extensions",
  "private": true,
  "description": "Will Hampson's Pi coding agent extensions: pstack, quiet, and personal packages",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "read-yaml-file@1.1.0>js-yaml": "3.15.2",
      "@changesets/parse@0.4.3>js-yaml": "4.3.2"
    }
  },
  "keywords": [
    "pi-package"
  ],
  "dependencies": {
    "undici": "^8.10.2"
  },
  "scripts": {
    "check": "node scripts/check-packages.mjs",
    "test": "pnpm -r run test && node --test scripts/*.test.mjs",
    "test:local": "node scripts/check-packages.mjs && echo \"Try: pi -e ./packages/<name>\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "tag-packages": "node scripts/tag-packages.mjs",
    "release": "pnpm -r publish --access public"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5"
  },
  "pi": {
    "extensions": [
      "./packages/pi-quiet/extensions/quiet/index.ts",
      "./packages/pi-pstack/extensions/pstack/index.ts",
      "./packages/pi-answer/extensions/answer/index.ts",
      "./packages/pi-btw/extensions/btw/index.ts",
      "./packages/pi-files/extensions/files/index.ts",
      "./packages/pi-local-vllm-thinking-budget/extensions/local-vllm-thinking-budget/index.ts",
      "./packages/pi-session-breakdown/extensions/session-breakdown/index.ts",
      "./packages/pi-todos/extensions/todos/index.ts",
      "./packages/pi-tokps/extensions/tokps/index.ts",
      "./packages/pi-jev-pruner/extensions/jev-pruner/index.ts"
    ],
    "skills": [
      "./packages/pi-pstack/skills"
    ],
    "subagents": {
      "agents": [
        "./packages/pi-pstack/agents"
      ]
    }
  }
}
