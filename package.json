{
  "name": "pi-extensions",
  "private": true,
  "description": "Whamp fork of Pi coding agent extensions, retaining pi-pstack and pi-quiet",
  "packageManager": "pnpm@9.15.0",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "check": "node scripts/check-packages.mjs",
    "test": "pnpm --filter @zenspc/pi-pstack test && pnpm --filter @zenspc/pi-quiet test && node --test scripts/*.test.mjs",
    "test:local": "node scripts/check-packages.mjs && echo \"Try: pi -e ./packages/<name>\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "tag-packages": "node scripts/tag-packages.mjs",
    "release": "pnpm -r publish --access public"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5"
  },
  "pi": {
    "extensions": [
      "./packages/pi-quiet/src/index.ts",
      "./packages/pi-pstack/extensions/pstack/index.ts"
    ]
  }
}
